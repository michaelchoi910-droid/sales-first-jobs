# Fireflies API
# Get your API key from: https://app.fireflies.ai/integrations/custom/fireflies
FIREFLIES_API_KEY=your_fireflies_api_key_here

# Anthropic Claude API
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud Credentials
# Create a service account and download the JSON key file
# Guide: https://cloud.google.com/docs/authentication/getting-started
GOOGLE_CREDENTIALS_PATH=/path/to/your/service-account-key.json

# Optional: Customize processing
MAX_TOKENS_PER_SECTION=4000  # Max tokens to send to Claude per section
TARGET_PAGES_PER_SECTION=4   # Target pages per section summary
